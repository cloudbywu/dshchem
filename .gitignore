# ─────────────────────────────────────────────────────────────────────────
# dshchem — ignore rules
#
# Source lives in packages/, test/, tools/, reports/ and research/.
# ─────────────────────────────────────────────────────────────────────────

# Checked-out dependencies — not this repository's source.
# deepseek-harness/ is a separate clone of the upstream harness
# (github.com/deepseek-ai/deepseek-harness) used for reference/development.
node_modules/
deepseek-harness/

# Python bytecode and virtualenvs.
__pycache__/
*.py[cod]
.venv/
venv/

# Local literature corpus: reference PDFs stay on disk, never committed
# (publisher copyright). papers/README.md documents the convention and stays
# tracked; test/fixtures/*.pdf are synthetic fixtures and also stay tracked.
papers/*
!papers/README.md

# Generated test artifacts (rewritten by test/integration.mjs).
test/screen-report*.md

# Secrets and local credentials.
.env
.env.*
!.env.example
*.local

# Local DSH runtime state (recipe library, sessions, caches).
.dsh/

# Editors and OS metadata.
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
